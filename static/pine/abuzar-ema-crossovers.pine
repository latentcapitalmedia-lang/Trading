//@version=6
indicator(title="Abuzar- EMA CROSSOVERS SIGNALS ", overlay=true)

// Timeframe selection for high, low, and close levels
timeFrame = input.timeframe(defval="D", title="Interval for High/Low/Close:")

// Get the high, low, and close prices for the selected timeframe
mydhigh = request.security(syminfo.tickerid, timeFrame, high)
mydlow = request.security(syminfo.tickerid, timeFrame, low)
mydclose = request.security(syminfo.tickerid, timeFrame, close)

// Plot the levels
plot(mydhigh, color=color.new(#00ff00, 0), linewidth=2, title="High")
plot(mydlow, color=color.new(#ff0000, 0), linewidth=2, title="Low")
plot(mydclose, color=color.new(#000000, 0), linewidth=2, title="Close")

// --- Adding EMA1 and EMA2 with Custom Timeframes ---

// Input lengths and timeframes for EMA1 and EMA2
ema1_length = input.int(defval=9, title="EMA 1 Length")   // Default EMA1 is 9 periods
ema2_length = input.int(defval=21, title="EMA 2 Length")  // Default EMA2 is 21 periods
ema_timeframe_1 = input.timeframe(defval="D", title="Timeframe for EMA1/EMA2")

// Calculate EMA1 and EMA2 with the selected timeframe
ema1 = ta.ema(request.security(syminfo.tickerid, ema_timeframe_1, close), ema1_length)
ema2 = ta.ema(request.security(syminfo.tickerid, ema_timeframe_1, close), ema2_length)

// Plot EMA1 and EMA2
plot(ema1, color=color.blue, linewidth=2, title="EMA 1")
plot(ema2, color=color.orange, linewidth=2, title="EMA 2")

// --- Crossover Conditions for EMA1 and EMA2 ---
ema_crossover = ta.crossover(ema1, ema2)  // EMA1 crosses above EMA2
ema_crossunder = ta.crossunder(ema1, ema2)  // EMA1 crosses below EMA2

// Alert Conditions for EMA1 and EMA2 crossover
alertcondition(ema_crossover, title="EMA1 Crossover", message="EMA 1 has crossed above EMA 2")
alertcondition(ema_crossunder, title="EMA1 Crossunder", message="EMA 1 has crossed below EMA 2")

// Optional: Add visual symbols for EMA1 and EMA2 crossovers
plotshape(series=ema_crossover, title="EMA1 Crossover", location=location.belowbar, color=color.green, style=shape.triangleup, size=size.small)
plotshape(series=ema_crossunder, title="EMA1 Crossunder", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small)

// --- Adding EMA3 and EMA4 with Custom Timeframes ---

// Input lengths and timeframes for EMA3 and EMA4
ema3_length = input.int(defval=50, title="EMA 3 Length")   // Default EMA3 is 50 periods
ema4_length = input.int(defval=100, title="EMA 4 Length")  // Default EMA4 is 100 periods
ema_timeframe_2 = input.timeframe(defval="D", title="Timeframe for EMA3/EMA4")

// Calculate EMA3 and EMA4 with the selected timeframe
ema3 = ta.ema(request.security(syminfo.tickerid, ema_timeframe_2, close), ema3_length)
ema4 = ta.ema(request.security(syminfo.tickerid, ema_timeframe_2, close), ema4_length)

// Plot EMA3 and EMA4
plot(ema3, color=color.purple, linewidth=2, title="EMA 3")
plot(ema4, color=color.yellow, linewidth=2, title="EMA 4")

// --- Crossover Conditions for EMA3 and EMA4 ---
ema_crossover_2 = ta.crossover(ema3, ema4)  // EMA3 crosses above EMA4
ema_crossunder_2 = ta.crossunder(ema3, ema4)  // EMA3 crosses below EMA4

// Alert Conditions for EMA3 and EMA4 crossover
alertcondition(ema_crossover_2, title="EMA3 Crossover", message="EMA 3 has crossed above EMA 4")
alertcondition(ema_crossunder_2, title="EMA3 Crossunder", message="EMA 3 has crossed below EMA 4")

// Optional: Add visual symbols for EMA3 and EMA4 crossovers
plotshape(series=ema_crossover_2, title="EMA3 Crossover", location=location.belowbar, color=color.lime, style=shape.triangleup, size=size.small)
plotshape(series=ema_crossunder_2, title="EMA3 Crossunder", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small)

// --- Adding EMA5 with Custom Timeframes ---

// Input lengths and timeframe for EMA5
ema5_length = input.int(defval=200, title="EMA 5 Length")  // Default EMA5 is 200 periods
ema_timeframe_3 = input.timeframe(defval="D", title="Timeframe for EMA5")

// Calculate EMA5 with the selected timeframe
ema5 = ta.ema(request.security(syminfo.tickerid, ema_timeframe_3, close), ema5_length)

// Plot EMA5
plot(ema5, color=color.fuchsia, linewidth=2, title="EMA 5")

// --- Crossover Conditions for EMA5 ---
ema_crossover_3 = ta.crossover(ema5, ema4)  // EMA5 crosses above EMA4
ema_crossunder_3 = ta.crossunder(ema5, ema4)  // EMA5 crosses below EMA4

// Alert Conditions for EMA5 crossover
alertcondition(ema_crossover_3, title="EMA5 Crossover", message="EMA 5 has crossed above EMA 4")
alertcondition(ema_crossunder_3, title="EMA5 Crossunder", message="EMA 5 has crossed below EMA 4")

// Optional: Add visual symbols for EMA5 crossovers
plotshape(series=ema_crossover_3, title="EMA5 Crossover", location=location.belowbar, color=color.fuchsia, style=shape.triangleup, size=size.small)
plotshape(series=ema_crossunder_3, title="EMA5 Crossunder", location=location.abovebar, color=color.red, style=shape.triangledown, size=size.small)
